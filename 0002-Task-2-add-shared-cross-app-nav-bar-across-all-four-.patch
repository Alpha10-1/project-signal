+++ b/scripts/project_signal_allocation.html
@@ -91,10 +91,26 @@ h1.title{font-family:'Space Grotesk';font-weight:700;font-size:28px;letter-spaci
 
 footer.note{margin-top:24px;padding-top:16px;border-top:1px solid var(--line);color:var(--dim);font-size:11px;line-height:1.6;}
 footer.note b{color:var(--muted);}
+.ps-suite-nav{display:flex;align-items:center;justify-content:space-between;padding:8px 0 10px;margin-bottom:14px;border-bottom:1px solid var(--line-soft);font-family:'IBM Plex Mono';}
+.ps-suite-wordmark{font-size:10.5px;letter-spacing:.18em;color:var(--dim);text-transform:uppercase;}
+.ps-suite-links{display:flex;gap:18px;}
+.ps-suite-links a{font-size:11.5px;color:var(--dim);text-decoration:none;letter-spacing:.03em;text-transform:uppercase;padding-bottom:3px;border-bottom:2px solid transparent;transition:color .15s,border-color .15s;}
+.ps-suite-links a:hover{color:var(--text);}
+.ps-suite-links a.ps-current{color:var(--text);border-color:var(--amber);}
 </style>
 </head>
